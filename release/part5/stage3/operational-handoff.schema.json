{
  "$defs": {
    "claim_boundaries": {
      "additionalProperties": false,
      "properties": {
        "production": {
          "const": "NOT_CLAIMED"
        },
        "settled_billing": {
          "const": "UNCLAIMED"
        },
        "sustained_operation": {
          "const": "NOT_ESTABLISHED"
        }
      },
      "required": [
        "production",
        "settled_billing",
        "sustained_operation"
      ],
      "type": "object"
    },
    "controls_authority": {
      "additionalProperties": false,
      "properties": {
        "main_ci_run_id": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "merge_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "main_ci_run_id",
        "merge_commit"
      ],
      "type": "object"
    },
    "project_completion": {
      "additionalProperties": false,
      "properties": {
        "all_part5_stages_complete": {
          "const": false
        },
        "project_complete": {
          "const": false
        },
        "remaining_work_required": {
          "const": true
        }
      },
      "required": [
        "all_part5_stages_complete",
        "project_complete",
        "remaining_work_required"
      ],
      "type": "object"
    },
    "rehearsal": {
      "additionalProperties": false,
      "properties": {
        "authority_file_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        "category": {
          "enum": [
            "ESCALATION",
            "OPERATION",
            "RECOVERY"
          ]
        },
        "decision": {
          "minLength": 1,
          "type": "string"
        },
        "expected_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prohibited_actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "result": {
          "const": "PASS"
        },
        "scenario_id": {
          "pattern": "^[a-z][a-z0-9-]+$",
          "type": "string"
        }
      },
      "required": [
        "authority_file_sha256",
        "category",
        "decision",
        "expected_evidence",
        "prohibited_actions",
        "result",
        "scenario_id"
      ],
      "type": "object"
    },
    "runtime_equivalence": {
      "additionalProperties": false,
      "properties": {
        "baseline_source_commit": {
          "const": "08559b0f48708080335282c6d59faa3826635d67"
        },
        "file_count": {
          "const": 107
        },
        "files_sha256": {
          "const": "2e1d10c936c23637929e65589fab324c4a2602b98da283135527733ea26f1e38"
        },
        "result": {
          "const": "PASS"
        }
      },
      "required": [
        "baseline_source_commit",
        "file_count",
        "files_sha256",
        "result"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_billed_cost_claim": {
      "const": "UNCLAIMED"
    },
    "authority_file_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "aws_execution": {
      "const": false
    },
    "claim_boundaries": {
      "$ref": "#/$defs/claim_boundaries"
    },
    "claim_level": {
      "const": "LOCAL_VERIFIED"
    },
    "closed_gap_ids": {
      "items": {
        "const": "P5-GAP-003"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "controls_authority": {
      "$ref": "#/$defs/controls_authority"
    },
    "evidence_type": {
      "const": "part5-stage3-operational-handoff"
    },
    "part": {
      "const": 5
    },
    "project": {
      "const": "AtlasRetail"
    },
    "project_completion": {
      "$ref": "#/$defs/project_completion"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rehearsals": {
      "items": {
        "$ref": "#/$defs/rehearsal"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "remaining_gap_ids": {
      "items": {
        "enum": [
          "P5-GAP-001",
          "P5-GAP-002",
          "P5-GAP-004",
          "P5-GAP-005",
          "P5-GAP-006"
        ]
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "runtime_equivalence": {
      "$ref": "#/$defs/runtime_equivalence"
    },
    "schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "const": 3
    },
    "stage1_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stage2_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "const": "OPERATIONAL_HANDOFF_VERIFIED"
    }
  },
  "required": [
    "actual_billed_cost_claim",
    "authority_file_sha256",
    "aws_execution",
    "claim_boundaries",
    "claim_level",
    "closed_gap_ids",
    "controls_authority",
    "evidence_type",
    "part",
    "project",
    "project_completion",
    "receipt_sha256",
    "rehearsals",
    "remaining_gap_ids",
    "runtime_equivalence",
    "schema_sha256",
    "schema_version",
    "stage",
    "stage1_contract_sha256",
    "stage2_receipt_sha256",
    "state"
  ],
  "title": "AtlasRetail Part 5 Stage 3 operational handoff",
  "type": "object"
}
