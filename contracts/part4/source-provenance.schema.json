{
  "$id": "https://github.com/bhuvaneshwaranmurugan21/atlasretail-lakehouse-platform/contracts/part4/source-provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "bundle_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_results_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "compressed_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "logical_records_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "path": {
            "pattern": "^[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "rows": {
            "minimum": 0,
            "type": "integer"
          },
          "size_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "table": {
            "enum": [
              "inventory_movements",
              "order_lines",
              "orders",
              "payments",
              "products",
              "returns"
            ]
          },
          "uncompressed_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "table",
          "path",
          "rows",
          "logical_records_sha256",
          "uncompressed_sha256",
          "compressed_sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "canonical_json": {
          "const": "UTF8_SORTED_COMPACT_NDJSON_LF"
        },
        "compression": {
          "const": "GZIP_LEVEL_9_MTIME_0_NO_FILENAME_OS_255"
        },
        "format_version": {
          "const": "1.0.0"
        },
        "python_implementation": {
          "minLength": 1,
          "type": "string"
        },
        "python_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "zlib_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format_version",
        "canonical_json",
        "compression",
        "python_implementation",
        "python_version",
        "zlib_version"
      ],
      "type": "object"
    },
    "managed_manifest_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "as_of_knowledge_time": {
          "minimum": 0,
          "type": "integer"
        },
        "fault": {
          "enum": [
            "none",
            "financial",
            "temporal-overlap"
          ]
        },
        "order_count": {
          "maximum": 2000,
          "minimum": 100,
          "type": "integer"
        },
        "produced_at": {
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "order_count",
        "seed",
        "fault",
        "produced_at",
        "as_of_knowledge_time"
      ],
      "type": "object"
    },
    "provenance_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository": {
      "const": "bhuvaneshwaranmurugan21/atlasretail-lakehouse-platform"
    },
    "source_manifest_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scenario_catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "source_family": {
      "enum": [
        "failure_recovery",
        "financial",
        "success",
        "tamper",
        "temporal"
      ]
    },
    "target_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source_commit",
    "source_family",
    "batch_id",
    "contract_sha256",
    "expected_results_sha256",
    "target_sha256",
    "scenario_catalog_sha256",
    "source_manifest_schema_sha256",
    "managed_manifest_schema_sha256",
    "generator",
    "parameters",
    "provenance_schema_sha256",
    "files",
    "manifest_sha256",
    "bundle_content_sha256",
    "receipt_sha256"
  ],
  "title": "AtlasRetail Part 4 deterministic source provenance receipt",
  "type": "object",
  "$defs": {
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
